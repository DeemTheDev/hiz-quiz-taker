# ---------------------------------------------------------------------------
# HIV Prevention Quiz - environment variables
#
# Copy this file to `.env.local` for local development and fill in values.
# `.env*` files are git-ignored; never commit real secrets.
# On Vercel, set these under Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Stats backend: Upstash Redis (REST) -----------------------------------
# Option A - credentials copied from the Upstash console
# (https://console.upstash.com -> your database -> REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option B - the Vercel Marketplace "Upstash for Redis" integration injects
# these automatically into your Vercel project. Locally you can pull them with
# `vercel env pull .env.local`. Either pair works; Option A wins if both are set.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# If neither pair is set:
#   - `next dev`  -> stats are kept IN MEMORY (reset on restart, one warning logged)
#   - production  -> stats are disabled; the quiz still works and the API
#                    answers { available: false, reason: "not_configured" }.

# --- Admin dashboard (/admin) ----------------------------------------------
# Single shared password for the stats dashboard and CSV export.
# Use a long random value (e.g. `openssl rand -base64 24`).
# Unset -> /admin shows a "not configured" card; nothing else is affected.
# Changing it logs every admin out (the session cookie is derived from it).
ADMIN_PASSWORD=

# --- Rate limiting ---------------------------------------------------------
# Random secret mixed into the SHA-256 hash of client IPs used as 1-hour
# rate-limit keys (20 quiz submissions / hour / client). Optional but strongly
# recommended so hashes cannot be reversed from a list of known IPs.
# Generate with `openssl rand -hex 32`.
RATE_LIMIT_SALT=

# --- Frontend (filled in by the main build) ---
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/the_status.quo/
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@the_status_quo
NEXT_PUBLIC_SITE_URL=
